<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{site.name}}</title>
  <link rel="stylesheet" type="text/css" href="css/site.css" />
  <link rel="icon" type="image/svg+xml" href="images/site.svg" />
  <meta property="og:title" content="{{site.name}}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{site.url}}" />
  <meta property="og:image" content="{{site.url}}/images/site.svg" />
  <meta name="description" property="og:description" content="{{site.description}}" />
</head>
<body>
<header>
  <section class="banner">
    <img alt="logo" src="images/site.svg" />
    <h1>{{site.name}}</h1>
  </section>
</header>
<main>
  <section class="articles">
    {{#each articles}}
    {{#with this as | article | }}
    <article>
        <header>
            <img alt="topic" src="./images/icons/topic.svg" />
            <h1><a href="article/{{article.meta.slug}}.html">{{article.meta.headline}}</a></h1>
            <h2>{{article.meta.subheadline}}</h2>
        </header>
        <section>
            <blockquote cite="article/{{article.meta.slug}}.html">
                {{{article.content.html}}}
            </blockquote>
        </section>
        <footer>
            <img class="author" alt="{{article.meta.author_slug}}" src="./images/team/{{article.meta.author_slug}}.jpeg" />
            <p class="author">{{article.meta.author_slug}}</p>
            <p class="published"><time datetime="{{article.meta.published_timestamp}}">{{article.meta.meta.published_timestamp}}</time></p>
        </footer>
    </article>
    {{/with}}
    {{/each}}
  </section>
</main>
<footer>
    <section class="copyright">
        <p>&copy; <a href="{{site.owner_url}}">{{site.owner}}</a> {{year}}</p>
    </section>
</footer>
</body>
</html>
