<article>
    <header>
        <img alt="topic" src="./images/icons/topic.svg" />
        <h1><a href="article/{{article.meta.slug}}.html">{{article.headline}}</a></h1>
        <h2>{{article.subheadline}}</h2>
    </header>
    <section>
        <blockquote cite="article/{{article.meta.slug}}.html">
            this.content_html
        </blockquote>
      </section>
    <footer>
        <img class="author" alt="{{article.meta.author_slug}}" src="./images/team/{{article.meta.author_slug}}.jpeg" />
        <p class="author">{{article.meta.author_slug}}</p>
        <p class="published"><time datetime="{{article.meta.published_timestamp}}">{{article.meta.published_timestamp}}</time></p>
    </footer>
</article>
